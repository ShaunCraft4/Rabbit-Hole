# Copy this file to .env.local (gitignored) and fill in your values.
# Every value here is server-side only: never prefix a secret with NEXT_PUBLIC_.
# Share real keys privately, never in git or in the team chat history.

# LLM: any OpenAI-compatible endpoint (AIsa if available, OpenAI, OpenRouter, Groq, ...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Model for prompts 1-2 (plan, extract)
LLM_MODEL_FAST=
# Model for prompts 3-4 (analyze, report)
LLM_MODEL_STRONG=

# Optional: Keenable works without a key; a key raises rate limits (keenable.ai/console)
KEENABLE_API_KEY=

# Optional: Solari cloud-browser fallback for pages Keenable cannot read (console.getsolari.com).
# Leave empty to disable the fallback.
SOLARI_API_KEY=
